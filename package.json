{
  "name": "kanpai",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON db/cli.ts up",
    "db:reset": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON db/cli.ts reset",
    "db:down": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON db/cli.ts down",
    "db:psql": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON db/cli.ts psql",
    "db:migrate": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON db/cli.ts migrate",
    "db:seed": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON db/seed.ts",
    "db:generate": "drizzle-kit generate",
    "token:issue": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON db/token.ts issue",
    "token:list": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON db/token.ts list",
    "token:revoke": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON db/token.ts revoke"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.10",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.16.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
